# TEMPLATE ONLY: intentionally unusable. Do not put actual secrets in this file.
# Install a separate root-owned /etc/qi-preview/preview.env with mode 0600.
# systemd EnvironmentFile syntax, NOT a shell script: no export or substitutions.
# Set exact HTTPS origin including non-default port if applicable, no trailing slash.
QI_PREVIEW_ORIGIN=
# Random unique login token, >=32 characters; generate privately, never in CLI args.
QI_WEB_TOKEN=
# Explicitly selected provider model and credential, provisioned privately.
OPENAI_MODEL=
OPENAI_API_KEY=
# Empty means official endpoint. Changing destination can disclose prompt data.
OPENAI_BASE_URL=
QI_MAX_CONTEXT_BYTES=262144
# Do not add worker credentials, plugin configuration, or additional CLI flags.
