# Default ACME uses reachable public TCP 80 and/or 443, not an arbitrary HTTPS port.
https://PREVIEW_HOST_INVALID {
	# FAIL CLOSED: keep until independently configured edge access control and rate
	# limiting are verified. Remove this respond ONLY during authorized activation.
	respond "Preview not activated" 503

	# Do not enable access logs containing credentials, cookies or request bodies.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "no-store"
	}
